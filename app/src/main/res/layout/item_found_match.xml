<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- 1. Image (Left Side, Compact) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgFoundItem"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:src="@drawable/gradient_bottom_shadow"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 2. Match Badge (Overlaid on Image Bottom) -->
        <!-- Uses a gradient or solid color background for high visibility -->
        <TextView
            android:id="@+id/tvMatchPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="95%"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_match_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginBottom="6dp"
            android:elevation="4dp"
            app:layout_constraintBottom_toBottomOf="@id/imgFoundItem"
            app:layout_constraintStart_toStartOf="@id/imgFoundItem"
            app:layout_constraintEnd_toEndOf="@id/imgFoundItem"/>

        <!-- 3. Title -->
        <TextView
            android:id="@+id/tvFoundTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="Black Leather Bag"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dark_accent"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/imgFoundItem"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnStartChat"/>

        <!-- 4. Location/Time -->
        <TextView
            android:id="@+id/tvFoundDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Liberty Market • 2h ago"
            android:textColor="@color/status_pending"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@id/tvFoundTitle"
            app:layout_constraintEnd_toEndOf="@id/tvFoundTitle"
            app:layout_constraintTop_toBottomOf="@id/tvFoundTitle"/>

        <!-- 5. Description (Shortened) -->
        <TextView
            android:id="@+id/tvFoundDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Found this bag on a bench. Looks like leather material."
            android:textColor="#606060"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toStartOf="@id/tvFoundTitle"
            app:layout_constraintEnd_toStartOf="@id/btnStartChat"
            app:layout_constraintTop_toBottomOf="@id/tvFoundDetails"/>

        <!-- 6. Compact Chat Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            android:padding="0dp"
            app:icon="@android:drawable/sym_action_chat"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:backgroundTint="@color/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>